rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Dữ liệu cá nhân của người chơi (GameSaveData)
    // Chỉ chủ tài khoản mới có quyền xem và sửa dữ liệu của chính mình
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Bảng xếp hạng toàn cầu (Global Leaderboards)
    // - Tất cả người chơi (kể cả khách) đều có thể đọc bảng xếp hạng
    // - Chỉ chủ tài khoản mới được ghi thông tin thứ hạng của mình
    match /leaderboards/{userId} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0;
    }
  }
}
